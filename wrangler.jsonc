/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "core",
  "account_id": "345590cd19a379d6bf1008c6a7860451",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "SPINE",
      "service": "spine"
    }
  ],
  "observability": {
    "enabled": true
  },
  "keep_vars": false,
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "dev": {
    "port": 3000,
    "local_protocol": "http"
  },

  // preview environment
  "env": {
    "preview": {
      "name": "core-preview",
      "routes": ["finasaan.com/preview*", "www.finasaan.com/preview*"],
      "services": [
        {
          "binding": "SPINE",
          "service": "spine-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview"
      }
    }
  }
}
